select TRUNC(sales_date, 'MM') as sales_date, sum(calc_total_price) as monthly_total from janta8182.sa_sales_invoice where company_code='01' group by TRUNC(sales_date, 'MM') ORDER BY sales_date;


SELECT TRUNC(SALES_DATE, 'YYYY') AS SALES_DATE, SUM(CALC_TOTAL_PRICE) AS YEARLY_SALES FROM JANTA8182.SA_SALES_INVOICE WHERE COMPANY_CODE='01' GROUP BY TRUNC(SALES_DATE, 'YYYY') ORDER BY SALES_DATE;



SELECT TRUNC(SALES_DATE, 'IW') AS SALES_DATE, SUM(CALC_TOTAL_PRICE) AS YEARLY_SALES FROM JANTA8182.SA_SALES_INVOICE WHERE COMPANY_CODE='01' GROUP BY TRUNC(SALES_DATE, 'IW') ORDER BY SALES_DATE;
